    <a id="BackToTop" href="#" title="Back to the top" class="back-to-top hide">
    <span>Back To Top</span> <i class="fa fa-arrow-circle-o-up fa-2x"></i>
    </a>
    <style>
        .back-to-top {
            position: fixed;
            
                bottom: 6em;
            
            right: 0px;
            text-decoration: none;
            color: #999;
            background-color: #eee;
            font-size: 16px;
            padding: 0.3em;
            -webkit-border-top-left-radius: 3px;
            -webkit-border-bottom-left-radius: 3px;
            -moz-border-radius-topleft: 3px;
            -moz-border-radius-bottomleft: 3px;
            border-top-left-radius: 3px;
            border-bottom-left-radius: 3px;
            z-index: 60000;
        }
        .back-to-top i {
            vertical-align: middle;
        }
        .back-to-top span {
            padding-left: 0.5em;
        }
        .back-to-top i + span {
            padding-left: 0;
        }
        .back-to-top:hover {
            text-decoration: none;
            color: #555;
        }
    </style>
    <script>
    (function() {
    function trackScroll() {
        var scrolled = window.pageYOffset;
        var coords = 2000;

        if (scrolled > coords) {
            goTopBtn.classList.remove('hide');
        }
        if (scrolled < coords) {
            goTopBtn.classList.add('hide');
        }
    }

    function backToTop() {
        if (window.pageYOffset > 0) {
            window.scrollBy(0, -80);
            setTimeout(backToTop, 0);
        }
    }

    var goTopBtn = document.querySelector('.back-to-top');

    window.addEventListener('scroll', trackScroll);
    goTopBtn.addEventListener('click', backToTop);
    })();
    </script><script>var hcNarniaPopup = false;</script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    function getCookie(name) {
      var value = '; ' + document.cookie;
      var parts = value.split('; ' + name + '=');
      if (parts.length === 2) return parts.pop().split(';').shift();
    }

    function setCookie(name, value, days) {
      var expires = '';
      if (days) {
        var date = new Date();
        date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
        expires = '; expires=' + date.toUTCString();
      }
      document.cookie = name + '=' + (value || '') + expires + '; path=/';
    }

    var consentCookieName = '_hc_privacy_video';

    function createModal() {
      var modal = document.createElement('div');
      modal.className = 'video-consent-modal active';
      modal.id = 'video-consent-modal';
      modal.innerHTML = `
        <div class="video-consent-modal-content">
          <div class="video-modal-text">
            <p>By watching video content on or through our Services, you are consenting to share your personal information, together with your Viewing Activities, with third parties acting on our behalf and with our advertising and analytic partners described in our <a href="/pages/privacy-notice-highlights" target="_blank" title="/pages/privacy-notice-highlights">Privacy Notice</a>. For more information, please see our <a href="/pages/video-services-notice">Video Services Notice</a>.</p>
          </div>
          <button class="btn video-modal-continue">Continue</button>
        </div>`;
      return modal;
    }

    function consentGiven() {
      setCookie(consentCookieName, 'true', 365);
      var overlays = document.querySelectorAll('.video-overlay');
      overlays.forEach(function (overlay) {
        let parentNode = overlay.parentNode;
        if (!parentNode) return;
        parentNode.removeChild(overlay);

        let iframe = parentNode.querySelector('iframe');
        if (iframe) {
          let src = iframe.getAttribute('data-disabled-src');
          iframe.removeAttribute('data-disabled-src');
          if (iframe.getAttribute('data-lazy-load') === 'true') iframe.setAttribute('data-src', src);
          else iframe.setAttribute('src', src);
        }

        let tiktokEmbed = parentNode.querySelector('.hidden-tiktok-embed');
        if(tiktokEmbed) {
          var embed = document.createElement("div");
          var script = document.createElement("script");
          script.setAttribute("async", true);
          script.setAttribute("src", "https://www.tiktok.com/embed.js");
          embed.innerHTML = tiktokEmbed.innerText;
          parentNode.removeChild(tiktokEmbed);
          parentNode.appendChild(embed);
          parentNode.appendChild(script);
        }
      });
    }

    function checkSrc(src) {
      const formats = ['youtube.com', 'youtu.be', 'youtube-nocookie.com', 'vimeo.com', 'tiktok.com'];
      return formats.find((format) => src.indexOf(format) !== -1);
    }

    function setUpOverlay(iframe) {
      var src = iframe.getAttribute('src') ?? iframe.getAttribute('data-src');
      var lazyLoad = iframe.hasAttribute('data-src');
      if (!src || !checkSrc(src)) return;

      iframe.removeAttribute('src');
      iframe.removeAttribute('data-src');
      iframe.setAttribute('data-disabled-src', src);
      iframe.setAttribute('data-lazy-load', lazyLoad);

      var grandParent = iframe.parentNode.parentNode;
      var immediateParent = iframe.parentNode;
      var wrapper = document.createElement('div');
      wrapper.className = 'video-iframe-wrapper';
      grandParent.insertBefore(wrapper, immediateParent);
      wrapper.appendChild(immediateParent);

      setOverlay(wrapper, "");
    }

    function setOverlay(wrapper, classes = "") {

      var overlay = document.createElement('div');
      overlay.className = `video-overlay ${classes}`;

      wrapper.appendChild(overlay);
      var modal = createModal();
      overlay.appendChild(modal);
      modal.querySelector('.video-modal-continue').addEventListener('click', function (e) {
        e.stopPropagation();
        consentGiven();
      });
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) {
          consentGiven();
        }
      });
    }

    function removeLazyLoad(entries) {
      let firstIntersected = 0;
      let lastIntersected = 0;
      entries.forEach((entry, index) => {
        if (entry?.isIntersecting) {
          entry?.target?.setAttribute('data-lazy-load', 'false');
          if(!firstIntersected)
            firstIntersected = index
          lastIntersected = index;
        };

        if(index == lastIntersected + 1)
          entry?.target?.setAttribute('data-lazy-load', 'false');
      });

      if(firstIntersected)
        entries[firstIntersected - 1]?.target?.setAttribute('data-lazy-load', 'false');
    }

    function buildTikTokContainer(parent, embed) {
      var container = document.createElement('div');
      container.classList.add('hidden-tiktok-embed');
      container.innerText = embed.outerHTML;
      parent.appendChild(container);
      parent.removeChild(embed);
    }

    setTimeout(function () {
      const iframes = document.querySelectorAll('iframe');
      // If the cookie is present, don't wrap anything
      if (getCookie(consentCookieName)) return;

      const observer = new IntersectionObserver((entries) => removeLazyLoad(entries));
      // If cookie is not present, set up overlay
      iframes.forEach((iframe) => {
        observer.observe(iframe);
        setUpOverlay(iframe);
      });

      const tiktokEmbeds = document.querySelectorAll('.tiktok-embed');
      tiktokEmbeds.forEach((embed) => {
        const parent = embed.parentNode;
        buildTikTokContainer(parent, embed);
        setOverlay(parent, "tiktok-overlay");
      });

      // have to remove the script or it'll bug out on lazy load
      const tiktokScript = document.querySelectorAll('script[src="https://www.tiktok.com/embed.js"]');
      tiktokScript.forEach((script) => {
        script.remove()
      })
    }, 500);
  });
</script>
